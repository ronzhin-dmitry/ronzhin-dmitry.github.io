#!/usr/bin/env bash
set -euo pipefail

if ! command -v rbenv >/dev/null 2>&1; then
  echo "rbenv is required. Install it with: brew install rbenv ruby-build" >&2
  exit 1
fi

if ! rbenv prefix "$(tr -d '[:space:]' < .ruby-version)" >/dev/null 2>&1; then
  echo "Required Ruby is not installed. Run: rbenv install" >&2
  exit 1
fi

exec rbenv exec bundle exec jekyll serve \
  --config _config.yml,_config.dev.yml \
  --livereload \
  --host 127.0.0.1
